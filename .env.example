# ─────────────────────────────────────────────────────────────────────────────
# SIEM Assistant — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-a-very-long-random-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://siem:siem_secret@postgres:5432/siemdb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_secret@redis:6379/0
CELERY_BROKER_URL=redis://:redis_secret@redis:6379/1

# ── SIEM Platform ─────────────────────────────────────────────────────────────
# Platform: mock | elastic | splunk | sentinel | qradar | wazuh
SIEM_PLATFORM=mock
USE_MOCK_DATA=true

# ── Elasticsearch (if SIEM_PLATFORM=elastic) ─────────────────────────────────
SIEM_URL=http://elasticsearch:9200
SIEM_USERNAME=elastic
SIEM_PASSWORD=changeme
# OR use API key instead:
# SIEM_API_TOKEN=your-elasticsearch-api-key

# ── Splunk (if SIEM_PLATFORM=splunk) ─────────────────────────────────────────
# SIEM_URL=https://your-splunk-host:8089
# SIEM_USERNAME=admin
# SIEM_PASSWORD=your-splunk-password

# ── AI / NLU ──────────────────────────────────────────────────────────────────
# Leave empty to use pattern-matching fallback (no API key needed)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# ── Threat Intelligence APIs ──────────────────────────────────────────────────
# Leave empty for mock data
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# ── Reports ───────────────────────────────────────────────────────────────────
REPORTS_DIR=/app/reports
MAX_REPORT_SIZE_MB=50

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate Limiting (queries/minute per role) ───────────────────────────────────
RATE_LIMIT_ANALYST=10
RATE_LIMIT_SENIOR_ANALYST=30
RATE_LIMIT_SOC_MANAGER=100

# ── Demo Credentials (auto-created on first startup) ─────────────────────────
DEMO_ANALYST_USERNAME=analyst
DEMO_ANALYST_PASSWORD=analyst123
DEMO_MANAGER_USERNAME=manager
DEMO_MANAGER_PASSWORD=manager123

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
